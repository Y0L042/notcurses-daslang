options gen2

require daslib/fio

[export]
def initialize(project_path : string) {
    if (das_is_dll_build()) {
        register_dynamic_module("{project_path}/dasNotcurses.shared_module",  "Module_dasNotcurses")
        register_dynamic_module("{project_path}/dasNcdirect.shared_module",   "Module_dasNcdirect")
    }
}
