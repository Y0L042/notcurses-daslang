options gen2

require daslib/daspkg

[export]
def package() {
    package_name("notcurses-daslang")
    package_author("Y0L042")
    package_description("Daslang bindings for notcurses (Windows, multimedia disabled)")
    package_license("Apache-2.0")
    package_tag("tui")
    package_tag("notcurses")
}

[export]
def resolve(sdk_version, version : string) {
    if (version == "" || version == "latest") {
        download_branch("main")
    } else {
        download_tag("v{version}")
    }
}

[export]
def dependencies(version : string) {
}

[export]
def build() {
    // A plain cmake_build() can't work here: the top-level CMakeLists needs
    // notcurses (headers + import lib) to already exist, and vendors/ is not
    // shipped. tools/bootstrap.sh clones+builds notcurses, builds the modules
    // (clang-cl / MSVC ABI), and stages the runtime DLLs next to them.
    //
    // daspkg runs this through `cmd.exe /c "cd <pkg> && <command>"`, so we hand
    // the script to MSYS2 bash. Prefer the well-known UCRT64 bash; fall back to
    // whatever `bash` is on PATH.
    custom_build("(if exist C:\\msys64\\usr\\bin\\bash.exe (C:\\msys64\\usr\\bin\\bash.exe tools/bootstrap.sh) else (bash tools/bootstrap.sh))")
}
